{
  "name": "\u05d3\u05d7\u05d9\u05e4\u05d4 \u05dc\u05de\u05e2\u05e8\u05db\u05ea crm \u05e9\u05dc \u05e0\u05ea\u05d9",
  "description": "\u05e9\u05d5\u05dc\u05e4\u05ea \u05e7\u05e8\u05d9\u05d0\u05d5\u05ea \u05e9\u05de\u05e7\u05d5\u05e8\u05df \u05d1\u05e0\u05ea\u05d9 \u05e9\u05d4\u05e9\u05ea\u05e0\u05d5 \u05de\u05d0\u05d6 \u05d4\u05e8\u05d9\u05e6\u05d4 \u05d4\u05e7\u05d5\u05d3\u05de\u05ea (watermark \u05d1-Deno KV), \u05de\u05e9\u05d5\u05d5\u05d4 \u05db\u05dc \u05d0\u05d7\u05ea \u05de\u05d5\u05dc \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05d7\u05d9\u05d4 \u05d1-call_open_appeals, \u05d5\u05db\u05d5\u05ea\u05d1\u05ea \u05e8\u05e7 \u05d4\u05e4\u05e8\u05e9\u05d9\u05dd \u2014 \u05e2\u05d3 30 \u05e2\u05d3\u05db\u05d5\u05e0\u05d9\u05dd \u05dc\u05e8\u05d9\u05e6\u05d4.\n\u05db\u05d5\u05ea\u05d1\u05ea \u05d7\u05d6\u05e8\u05d4 \u05dc\u05e0\u05ea\u05d9: \u05e1\u05d2\u05d9\u05e8\u05d5\u05ea \u05d5\u05d1\u05d9\u05d8\u05d5\u05dc\u05d9\u05dd, \u05e9\u05d9\u05d1\u05d5\u05e6\u05d9 \u05e1\u05e4\u05e7\u05d9\u05dd, \u05d6\u05de\u05e0\u05d9 \u05d4\u05d2\u05e2\u05d4 \u05d5\u05e1\u05d9\u05d5\u05dd, \u05d4\u05e2\u05e8\u05d5\u05ea \u05de\u05d5\u05e7\u05d3 \u05d5\u05d0\u05d9\u05e9\u05d5\u05e8\u05d9 \u05d1\u05e7\u05e8\u05ea \u05d0\u05d9\u05db\u05d5\u05ea. \u05e9\u05de\u05e8\u05e0\u05d9\u05ea \u05dc\u05d2\u05de\u05e8\u05d9 \u2014 \u05dc\u05d0 \u05d3\u05d5\u05e8\u05e1\u05ea \u05e9\u05d5\u05dd \u05e0\u05ea\u05d5\u05df \u05e7\u05d9\u05d9\u05dd \u05d1\u05e0\u05ea\u05d9.",
